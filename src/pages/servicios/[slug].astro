---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { servicios, porSlug, type Servicio } from '../../data/servicios';
import { contacto, linkWhatsapp, url } from '../../data/sitio';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Servicio };
const relacionados = s.relacionados.map(porSlug);
const wa = linkWhatsapp(s.whatsapp);
---
<Base titulo={`${s.titulo} en Arica — Autocontrol Chile`} descripcion={s.intro} actual={s.slug}>
  <section class="wrap cabecera">
    <div class="cab-texto">
      <nav aria-label="Ruta" class="ruta">
        <a href={url()}>Inicio</a><span aria-hidden="true">/</span>
        <a href={`${url()}#servicios`}>Servicios</a><span aria-hidden="true">/</span>
        <span aria-current="page">{s.titulo}</span>
      </nav>
      <h1>{s.titulo}</h1>
      <p class="intro">{s.intro}</p>
      <div class="botones">
        <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Solicitar instalación <Icono nombre="flecha" size={18} stroke={2} /></a>
        <a class="btn btn-ghost" href={`tel:${contacto.telefonoLink}`}>Llamar</a>
      </div>
    </div>
    <div class="cab-foto">
      <img src={url(s.imagen)} alt={s.imagenAlt} fetchpriority="high" style={s.imagenPos ? `object-position:${s.imagenPos}` : undefined} />
    </div>
  </section>

  <section class="wrap detalle">
    <div class="card det-texto">
      <span class="kicker">{s.detalle.etiqueta}</span>
      <h2>{s.detalle.titulo}</h2>
      {s.detalle.parrafos.map((p) => <p class="lead">{p}</p>)}
      <div class="chips">{s.detalle.chips.map((c) => <span class="chip">{c}</span>)}</div>
    </div>
    {s.imagenDetalle ? (
      <div class="det-foto">
        <img src={url(s.imagenDetalle.src)} alt={s.imagenDetalle.alt} loading="lazy" />
        <div class="det-nota">
          <span class="ok-icon pequeno"><Icono nombre="escudo" size={22} stroke={2} /></span>
          <span>{s.imagenDetalle.nota}</span>
        </div>
      </div>
    ) : (
      <div class="sec-card">
        <span class="ok-icon"><Icono nombre="escudo" size={28} stroke={2} /></span>
        <h3>Instaladores certificados SEC</h3>
        <p>{s.sec}</p>
      </div>
    )}
  </section>

  <section class="otros">
    <div class="wrap otros-in">
      <h2 class="h2-chico">Otros servicios</h2>
      <div class="grid">
        {relacionados.map((r) => (
          <a class="lift rel" href={url(`servicios/${r.slug}/`)}>
            <img src={url(r.imagen)} alt="" loading="lazy" />
            <span class="rel-in">
              <span class="rel-titulo">{r.titulo}</span>
              <span class="rel-texto">{r.resumen}</span>
              <span class="mas">Ver más →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="wrap contacto">
    <div class="cta-band banda">
      <div class="banda-texto">
        <h2>¿Necesita una instalación?</h2>
        <p>{contacto.direccion}, Arica · {contacto.horarios.map((h) => `${h.dias} ${h.horas}`).join(' · ')}</p>
        <div class="banda-links">
          <a href={`tel:${contacto.telefonoLink}`}>{contacto.telefono}</a>
          <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
        </div>
      </div>
      <a class="btn btn-white" href={wa} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
    </div>
  </section>
</Base>

<style>
  .cabecera {
    padding-block: 72px 56px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }
  .cab-texto,
  .cab-foto {
    flex: 1 1 440px;
    min-width: 0;
  }
  .cab-texto {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .ruta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
  }
  .ruta [aria-current] {
    color: var(--head);
  }
  h1 {
    font-weight: 700;
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .intro {
    font-size: 18px;
    line-height: 1.7;
    color: var(--body);
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }
  .cab-foto img {
    width: 100%;
    height: clamp(280px, 36vw, 460px);
    object-fit: cover;
    border-radius: 24px;
  }

  .detalle {
    padding-block: 24px 88px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }
  .det-texto {
    padding: 40px;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .det-texto h2 {
    font-size: 32px;
    line-height: 1.12;
  }
  .det-foto {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 420px;
  }
  .det-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .det-nota {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    padding: 18px 20px;
    border-radius: 16px;
    background: rgba(10, 18, 32, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    gap: 14px;
    align-items: center;
    font-size: 15px;
    line-height: 1.5;
    color: #fff;
  }
  .pequeno {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }

  .otros {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .otros-in {
    padding-block: 88px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .h2-chico {
    font-size: clamp(28px, 3vw, 40px);
  }
  .rel {
    display: flex;
    flex-wrap: wrap;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .rel img {
    flex: 1 1 200px;
    min-height: 220px;
    width: 100%;
    object-fit: cover;
  }
  .rel-in {
    flex: 1 1 240px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rel-titulo {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 700;
    color: var(--head);
  }
  .rel-texto {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .mas {
    margin-top: auto;
    font-weight: 600;
    color: var(--kicker);
  }

  .contacto {
    padding-block: 88px;
  }
  .banda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .banda-texto {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .banda-texto h2 {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
  }
  .banda-texto p {
    font-size: 16px;
    line-height: 1.6;
    color: #d9deff;
  }
  .banda-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 16px;
    font-weight: 600;
  }
  .banda-links a {
    color: #fff;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .cabecera {
      padding-block: 40px 32px;
      gap: 32px;
    }
    .det-texto,
    .sec-card {
      padding: 28px;
    }
    .otros-in,
    .contacto {
      padding-block: 64px;
    }
  }
</style>
