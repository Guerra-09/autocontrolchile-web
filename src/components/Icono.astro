---
// Íconos de línea (stroke = currentColor), así toman el color del contenedor.
interface Props {
  nombre: string;
  size?: number;
  stroke?: number;
}
const { nombre, size = 24, stroke = 1.8 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'camara' && <><path d="M3 7l12-3 2 6-12 3z" /><path d="M17 10l4 1.5" /><path d="M8 12.5l1 3.5H4v4" /><circle cx="13" cy="7.5" r="1.2" /></>}
  {nombre === 'aire' && <><rect x="2" y="4" width="20" height="9" rx="2" /><path d="M6 10h12" /><path d="M7 17c0 1.5-1 2-1 3M12 17c0 1.5-1 2-1 3M17 17c0 1.5-1 2-1 3" /></>}
  {nombre === 'cerco' && <><path d="M5 21V6l2-2M12 21V6l2-2M19 21V6l2-2" /><path d="M5 9h14M5 13h14M5 17h14" /></>}
  {nombre === 'porton' && <><path d="M2 20h20" /><path d="M4 20V9l8-5 8 5v11" /><path d="M8 20v-8h8v8" /><path d="M10 12v8M14 12v8" /></>}
  {nombre === 'fuego' && <><path d="M12 2c1 3 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.5 1.5 1.5 2.5 2.5 2.5-.5-3 .5-6 .5-8z" /><path d="M12 22v-3" /></>}
  {nombre === 'cortina' && <><path d="M3 3h18v3H3z" /><path d="M4 6v14M20 6v14" /><path d="M4 9h16M4 12h16M4 15h16" /></>}
  {nombre === 'telefono' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />}
  {nombre === 'flecha' && <path d="M5 12h14M13 5l7 7-7 7" />}
  {nombre === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {nombre === 'sol' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {nombre === 'luna' && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
  {nombre === 'escudo' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" /></>}
  {nombre === 'whatsapp' && <><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" /><path d="M9 8.5c0 3.5 2.5 6.5 6.5 6.5l1-1.6-2-1-1 1c-1.3-.5-2.4-1.6-2.9-2.9l1-1-1-2-1.6 1z" /></>}
  {nombre === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nombre === 'mapa' && <><path d="M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></>}
  {nombre === 'reloj' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {nombre === 'correo' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
</svg>
